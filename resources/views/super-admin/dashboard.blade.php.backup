            <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between">
                <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                    أحدث الشركات
                </h2>
                <a href="{{ route('super-admin.tenants') }}" class="text-sm text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 font-medium flex items-center gap-1">
                    عرض الكل
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                </a>
            </div>
            <div class="p-6">
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-slate-50 dark:bg-slate-900">
                            <tr>
                                <th class="px-4 py-3 text-right text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider">اسم الشركة</th>
                                <th class="px-4 py-3 text-right text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider">الدومين</th>
                                <th class="px-4 py-3 text-right text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider">الحالة</th>
                                <th class="px-4 py-3 text-right text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider">تاريخ الإنشاء</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
                            <template x-for="tenant in recentTenants" :key="tenant.id">
                                <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors">
                                    <td class="px-4 py-4">
                                        <div class="flex items-center gap-3">
                                            <div class="w-10 h-10 bg-gradient-to-br from-indigo-500 to-indigo-600 rounded-lg flex items-center justify-center">
                                                <span class="text-white font-bold text-sm" x-text="tenant.name.charAt(0).toUpperCase()"></span>
                                            </div>
                                            <span class="text-sm font-semibold text-slate-900 dark:text-white" x-text="tenant.name"></span>
                                        </div>
                                    </td>
                                    <td class="px-4 py-4">
                                        <span class="text-sm text-slate-600 dark:text-slate-400 font-mono" x-text="tenant.domain"></span>
                                    </td>
                                    <td class="px-4 py-4">
                                        <span :class="tenant.active ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-300' : 'bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300'"
                                              class="px-3 py-1 text-xs font-bold rounded-full inline-flex items-center gap-1">
                                            <span class="w-2 h-2 rounded-full" :class="tenant.active ? 'bg-emerald-500' : 'bg-amber-500'"></span>
                                            <span x-text="tenant.active ? 'نشط' : 'غير نشط'"></span>
                                        </span>
                                    </td>
                                    <td class="px-4 py-4 text-sm text-slate-600 dark:text-slate-400" x-text="formatDate(tenant.created_at)"></td>
                                </tr>
                            </template>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Activity Timeline (1/3 width) -->
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg border border-slate-200 dark:border-slate-700">
            <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-700">
                <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    النشاطات الأخيرة
                </h2>
            </div>
            <div class="p-6 space-y-4 max-h-96 overflow-y-auto">
                <template x-for="activity in activitySummary.recent" :key="activity.id">
                    <div class="flex gap-3">
                        <div class="flex-shrink-0">
                            <div class="w-10 h-10 rounded-full flex items-center justify-center"
                                 :class="getActivityColor(activity.type)">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                                </svg>
                            </div>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-slate-900 dark:text-white" x-text="activity.description"></p>
                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1" x-text="formatRelativeTime(activity.created_at)"></p>
                        </div>
                    </div>
                </template>
                <div x-show="!activitySummary || !activitySummary.recent || activitySummary.recent.length === 0" class="text-center py-8 text-slate-500 dark:text-slate-400">
                    <svg class="w-12 h-12 mx-auto mb-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                    </svg>
                    <p class="text-sm">لا توجد نشاطات حديثة</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Keyboard Shortcuts Help Panel -->
    <div class="fixed bottom-4 right-4 z-40" x-data="{ showHelp: false }">
        <button @click="showHelp = !showHelp" class="bg-indigo-600 hover:bg-indigo-700 text-white p-3 rounded-full shadow-2xl transition-all hover:scale-110" title="مساعدة الاختصارات">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </button>

        <div x-show="showHelp" @click.away="showHelp = false" x-cloak
             class="absolute bottom-full right-0 mb-2 w-80 bg-white dark:bg-slate-800 rounded-xl shadow-2xl border border-slate-200 dark:border-slate-700 p-6"
             x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0 scale-95"
             x-transition:enter-end="opacity-100 scale-100">
            <h3 class="font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
                اختصارات لوحة المفاتيح
            </h3>
            <div class="space-y-3 text-sm">
                <div class="flex items-center justify-between">
                    <span class="text-slate-600 dark:text-slate-400">البحث السريع</span>
                    <kbd class="px-2 py-1 bg-slate-100 dark:bg-slate-700 text-slate-900 dark:text-white rounded border border-slate-300 dark:border-slate-600 font-mono text-xs">/</kbd>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-slate-600 dark:text-slate-400">تحديث البيانات</span>
                    <kbd class="px-2 py-1 bg-slate-100 dark:bg-slate-700 text-slate-900 dark:text-white rounded border border-slate-300 dark:border-slate-600 font-mono text-xs">R</kbd>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-slate-600 dark:text-slate-400">التحديث التلقائي</span>
                    <kbd class="px-2 py-1 bg-slate-100 dark:bg-slate-700 text-slate-900 dark:text-white rounded border border-slate-300 dark:border-slate-600 font-mono text-xs">A</kbd>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-slate-600 dark:text-slate-400">الوضع الداكن</span>
                    <kbd class="px-2 py-1 bg-slate-100 dark:bg-slate-700 text-slate-900 dark:text-white rounded border border-slate-300 dark:border-slate-600 font-mono text-xs">D</kbd>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-slate-600 dark:text-slate-400">الإشعارات</span>
                    <kbd class="px-2 py-1 bg-slate-100 dark:bg-slate-700 text-slate-900 dark:text-white rounded border border-slate-300 dark:border-slate-600 font-mono text-xs">N</kbd>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-slate-600 dark:text-slate-400">تصدير البيانات</span>
                    <kbd class="px-2 py-1 bg-slate-100 dark:bg-slate-700 text-slate-900 dark:text-white rounded border border-slate-300 dark:border-slate-600 font-mono text-xs">E</kbd>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-slate-600 dark:text-slate-400">إغلاق/إلغاء</span>
                    <kbd class="px-2 py-1 bg-slate-100 dark:bg-slate-700 text-slate-900 dark:text-white rounded border border-slate-300 dark:border-slate-600 font-mono text-xs">ESC</kbd>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Notification -->
    <div x-data="{ show: false, message: '', type: 'success' }" 
         @show-toast.window="show = true; message = $event.detail.message; type = $event.detail.type; setTimeout(() => show = false, 3000)"
         x-show="show" x-cloak
         class="fixed top-4 left-1/2 -translate-x-1/2 z-50"
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0 -translate-y-4"
         x-transition:enter-end="opacity-100 translate-y-0"
         x-transition:leave="transition ease-in duration-200"
         x-transition:leave-start="opacity-100 translate-y-0"
         x-transition:leave-end="opacity-0 -translate-y-4">
        <div :class="type === 'success' ? 'bg-emerald-500' : 'bg-red-500'" 
             class="px-6 py-3 rounded-xl shadow-2xl text-white font-semibold flex items-center gap-3">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span x-text="message"></span>
        </div>
    </div>

</div>
@endsection

@push('scripts')
<script>
function dashboard() {
    return {
        loading: true,
        stats: {
            total_tenants: 0,
            active_tenants: 0,
            inactive_tenants: 0,
            tenants_this_month: 0
        },
        subscriptionStats: null,
        activitySummary: { recent: [] },
        recentTenants: [],
        allTenants: [], // For search filtering
        allActivities: [], // For search filtering
        
        // New features state
        autoRefresh: false,
        refreshInterval: null,
        refreshCountdown: 30,
        showNotifications: false,
        notifications: [],
        searchQuery: '',
        isDarkMode: false,
        chartData: {
            tenants: [8, 10, 12, 11, 14, 16, 20],
            revenue: [5000, 6000, 5500, 7000, 8500, 9000, 10000],
            activities: [15, 22, 18, 25, 30, 28, 24]
        },

        async init() {
            await this.loadAllData();
            this.initKeyboardShortcuts();
            this.checkDarkMode();
            this.loadNotifications();
        },

        async loadAllData() {
            this.loading = true;
            try {
                await Promise.all([
                    this.loadDashboard(),
                    this.loadSubscriptionStats(),
                    this.loadActivitySummary()
                ]);
            } catch (error) {
                console.error('Error loading dashboard data:', error);
                this.showError('حدث خطأ أثناء تحميل البيانات');
            } finally {
                this.loading = false;
            }
        },

        async refreshDashboard() {
            await this.loadAllData();
            this.showSuccess('تم تحديث البيانات بنجاح');
        },

        async loadDashboard() {
            try {
                const response = await fetch('/api/super-admin/dashboard', {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/json',
                        'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content
                    },
                    credentials: 'include'
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const data = await response.json();

                if (data.success) {
                    this.stats.total_tenants = data.data.total_tenants || 0;
                    this.stats.active_tenants = data.data.active_tenants || 0;
                    this.stats.inactive_tenants = data.data.inactive_tenants || 0;
                    this.stats.tenants_this_month = data.data.tenants_this_month || 0;
                    this.allTenants = data.data.recent_tenants || [];
                    this.recentTenants = [...this.allTenants];
                }
            } catch (error) {
                console.error('Error loading dashboard:', error);
            }
        },

        async loadSubscriptionStats() {
            try {
                const response = await fetch('/api/super-admin/dashboard/subscription-stats', {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/json',
                        'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content
                    },
                    credentials: 'include'
                });

                if (response.ok) {
                    const data = await response.json();
                    if (data.success) {
                        this.subscriptionStats = data.data;
                    }
                }
            } catch (error) {
                console.error('Error loading subscription stats:', error);
            }
        },

        async loadActivitySummary() {
            try {
                const response = await fetch('/api/super-admin/dashboard/activity-summary', {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/json',
                        'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content
                    },
                    credentials: 'include'
                });

                if (response.ok) {
                    const data = await response.json();
                    if (data.success) {
                        this.allActivities = data.data.recent || [];
                        this.activitySummary = data.data;
                    }
                }
            } catch (error) {
                console.error('Error loading activity summary:', error);
            }
        },

        // Auto Refresh Feature
        toggleAutoRefresh() {
            this.autoRefresh = !this.autoRefresh;
            if (this.autoRefresh) {
                this.startAutoRefresh();
                this.showSuccess('تم تفعيل التحديث التلقائي');
            } else {
                this.stopAutoRefresh();
                this.showSuccess('تم إيقاف التحديث التلقائي');
            }
        },

        startAutoRefresh() {
            this.refreshCountdown = 30;
            this.refreshInterval = setInterval(() => {
                this.refreshCountdown--;
                if (this.refreshCountdown <= 0) {
                    this.refreshDashboard();
                    this.refreshCountdown = 30;
                }
            }, 1000);
        },

        stopAutoRefresh() {
            if (this.refreshInterval) {
                clearInterval(this.refreshInterval);
                this.refreshInterval = null;
            }
        },

        // Dark Mode Feature
        checkDarkMode() {
            this.isDarkMode = document.documentElement.classList.contains('dark');
        },

        toggleDarkMode() {
            if (this.isDarkMode) {
                document.documentElement.classList.remove('dark');
                localStorage.setItem('theme', 'light');
                this.isDarkMode = false;
                this.showSuccess('تم التبديل إلى الوضع الفاتح');
            } else {
                document.documentElement.classList.add('dark');
                localStorage.setItem('theme', 'dark');
                this.isDarkMode = true;
                this.showSuccess('تم التبديل إلى الوضع الداكن');
            }
        },

        // Notifications Feature
        loadNotifications() {
            // Sample notifications - in production, fetch from API
            this.notifications = [
                {
                    id: 1,
                    title: 'شركة جديدة',
                    message: 'تم تسجيل شركة جديدة: Tech Solutions',
                    time: new Date(Date.now() - 5 * 60000),
                    color: 'bg-gradient-to-br from-green-500 to-emerald-600'
                },
                {
                    id: 2,
                    title: 'دفعة جديدة',
                    message: 'تم استلام دفعة بمبلغ 5000 ج.م',
                    time: new Date(Date.now() - 15 * 60000),
                    color: 'bg-gradient-to-br from-blue-500 to-indigo-600'
                },
                {
                    id: 3,
                    title: 'تنبيه اشتراك',
                    message: 'اشتراك شركة XYZ ينتهي خلال 3 أيام',
                    time: new Date(Date.now() - 60 * 60000),
                    color: 'bg-gradient-to-br from-amber-500 to-amber-600'
                }
            ];
        },

        dismissNotification(id) {
            this.notifications = this.notifications.filter(n => n.id !== id);
            this.showSuccess('تم حذف الإشعار');
        },

        // Quick Search Feature
        filterData() {
            const query = this.searchQuery.toLowerCase().trim();
            
            if (!query) {
                this.recentTenants = [...this.allTenants];
                this.activitySummary.recent = [...this.allActivities];
                return;
            }

            // Filter tenants
            this.recentTenants = this.allTenants.filter(tenant => 
                tenant.name?.toLowerCase().includes(query) || 
                tenant.domain?.toLowerCase().includes(query)
            );

            // Filter activities
            this.activitySummary.recent = this.allActivities.filter(activity => 
                activity.description?.toLowerCase().includes(query)
            );
        },

        // Data Export Feature
        async exportData() {
            try {
                // Prepare CSV content
                let csv = 'اسم الشركة,الدومين,الحالة,تاريخ الإنشاء\n';
                
                this.allTenants.forEach(tenant => {
                    csv += `"${tenant.name}","${tenant.domain}","${tenant.active ? 'نشط' : 'غير نشط'}","${this.formatDate(tenant.created_at)}"\n`;
                });

                // Create and download file
                const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
                const link = document.createElement('a');
                const url = URL.createObjectURL(blob);
                const date = new Date().toISOString().split('T')[0];
                
                link.setAttribute('href', url);
                link.setAttribute('download', `tenants-export-${date}.csv`);
                link.style.visibility = 'hidden';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);

                this.showSuccess('تم تصدير البيانات بنجاح');
            } catch (error) {
                console.error('Error exporting data:', error);
                this.showError('فشل تصدير البيانات');
            }
        },

        // Keyboard Shortcuts Feature
        initKeyboardShortcuts() {
            document.addEventListener('keydown', (e) => {
                // "/" - Focus search
                if (e.key === '/' && !e.ctrlKey && !e.metaKey) {
                    e.preventDefault();
                    document.getElementById('quickSearch')?.focus();
                }
                
                // "R" - Refresh
                if (e.key === 'r' && !e.ctrlKey && !e.metaKey && document.activeElement.tagName !== 'INPUT') {
                    e.preventDefault();
                    this.refreshDashboard();
                }
                
                // "A" - Toggle auto-refresh
                if (e.key === 'a' && !e.ctrlKey && !e.metaKey && document.activeElement.tagName !== 'INPUT') {
                    e.preventDefault();
                    this.toggleAutoRefresh();
                }
                
                // "D" - Toggle dark mode
                if (e.key === 'd' && !e.ctrlKey && !e.metaKey && document.activeElement.tagName !== 'INPUT') {
                    e.preventDefault();
                    this.toggleDarkMode();
                }
                
                // "N" - Toggle notifications
                if (e.key === 'n' && !e.ctrlKey && !e.metaKey && document.activeElement.tagName !== 'INPUT') {
                    e.preventDefault();
                    this.showNotifications = !this.showNotifications;
                }
                
                // "E" - Export data
                if (e.key === 'e' && !e.ctrlKey && !e.metaKey && document.activeElement.tagName !== 'INPUT') {
                    e.preventDefault();
                    this.exportData();
                }
                
                // "Escape" - Close notifications/clear search
                if (e.key === 'Escape') {
                    this.showNotifications = false;
                    if (document.activeElement.id === 'quickSearch') {
                        this.searchQuery = '';
                        this.filterData();
                        document.activeElement.blur();
                    }
                }
            });
        },

        formatDate(date) {
            if (!date) return '-';
            return new Date(date).toLocaleDateString('ar-EG', {
                year: 'numeric',
                month: 'short',
                day: 'numeric'
            });
        },

        formatRelativeTime(date) {
            if (!date) return '-';
            const now = new Date();
            const then = new Date(date);
            const diffMs = now - then;
            const diffMins = Math.floor(diffMs / 60000);
            const diffHours = Math.floor(diffMs / 3600000);
            const diffDays = Math.floor(diffMs / 86400000);

            if (diffMins < 1) return 'الآن';
            if (diffMins < 60) return `منذ ${diffMins} دقيقة`;
            if (diffHours < 24) return `منذ ${diffHours} ساعة`;
            if (diffDays < 7) return `منذ ${diffDays} يوم`;
            return this.formatDate(date);
        },

        formatCurrency(amount) {
            if (!amount || isNaN(amount)) return '0 ج.م';
            return new Intl.NumberFormat('ar-EG', {
                style: 'currency',
                currency: 'EGP',
                minimumFractionDigits: 0,
                maximumFractionDigits: 0
            }).format(amount);
        },

        getActivityColor(type) {
            const colors = {
                'tenant_created': 'bg-gradient-to-br from-green-500 to-emerald-600',
                'tenant_updated': 'bg-gradient-to-br from-blue-500 to-indigo-600',
                'tenant_deleted': 'bg-gradient-to-br from-red-500 to-red-600',
                'subscription_created': 'bg-gradient-to-br from-purple-500 to-pink-600',
                'subscription_updated': 'bg-gradient-to-br from-indigo-500 to-purple-600',
                'payment_received': 'bg-gradient-to-br from-green-500 to-teal-600',
                'default': 'bg-gradient-to-br from-slate-500 to-slate-600'
            };
            return colors[type] || colors.default;
        },

        showSuccess(message) {
            window.dispatchEvent(new CustomEvent('show-toast', {
                detail: { message, type: 'success' }
            }));
        },

        showError(message) {
            window.dispatchEvent(new CustomEvent('show-toast', {
                detail: { message, type: 'error' }
            }));
        }
    }
}
</script>
@endpush
